          "name": "Update Task Status — Mark as Done",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{base_url}}/api/v1/tasks/{{task_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tasks", "{{task_id}}", "status"]
            },
            "header": [
              {
                "key": "Content-Type",
